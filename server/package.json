{
  "name": "@mangalibrary/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MangaLibrary backend - Fastify + Kysely + SQLite.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "spike": "tsx src/spikes/run.ts",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/etag": "^5.2.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/session": "^11.0.1",
    "@fastify/static": "^8.0.2",
    "7z-wasm": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "file-type": "^19.6.0",
    "kysely": "^0.27.4",
    "mupdf": "^1.28.1",
    "node-unrar-js": "^2.0.2",
    "pino": "^9.5.0",
    "piscina": "^4.7.0",
    "sharp": "^0.33.5",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
